{
  "name": "saxonberg",
  "private": true,
  "dependencies": {
    "@saxonberg/content-arcana": "workspace:*",
    "@saxonberg/content-arcane-library": "workspace:*",
    "@saxonberg/content-base-library": "workspace:*",
    "@saxonberg/content-corpo-aevex": "workspace:*",
    "@saxonberg/content-corpo-goodkin": "workspace:*",
    "@saxonberg/content-corpo-hollis": "workspace:*",
    "@saxonberg/content-corpo-veshko": "workspace:*",
    "@saxonberg/content-corpo-vionne": "workspace:*",
    "@saxonberg/content-distribution": "workspace:*",
    "@saxonberg/content-eternal-university": "workspace:*",
    "@saxonberg/content-expression": "workspace:*",
    "@saxonberg/content-generic-objects": "workspace:*",
    "@saxonberg/content-hearthworks": "workspace:*",
    "@saxonberg/content-hinkley-hills": "workspace:*",
    "@saxonberg/content-newbie-wilds": "workspace:*",
    "@saxonberg/content-platform": "workspace:*",
    "@saxonberg/content-rejection": "workspace:*",
    "@saxonberg/content-residence": "workspace:*",
    "@saxonberg/content-saxonberg-lounge": "workspace:*",
    "@saxonberg/content-species-and-names": "workspace:*",
    "@saxonberg/content-terminus": "workspace:*",
    "@saxonberg/content-tpa": "workspace:*",
    "@saxonberg/content-trade-bottling": "workspace:*",
    "@saxonberg/content-trade-brewing": "workspace:*",
    "@saxonberg/content-trade-distilling": "workspace:*",
    "@saxonberg/content-trade-farming": "workspace:*",
    "@saxonberg/content-trade-fuel": "workspace:*",
    "@saxonberg/content-trade-cooking": "workspace:*",
    "@saxonberg/content-trade-hospitality": "workspace:*",
    "@saxonberg/content-trade-mining": "workspace:*",
    "@saxonberg/content-trade-smelting": "workspace:*",
    "@saxonberg/content-trade-smithing": "workspace:*",
    "@saxonberg/content-trade-winemaking": "workspace:*",
    "@saxonberg/content-transport": "workspace:*",
    "@saxonberg/content-water": "workspace:*",
    "@saxonberg/content-wiki-starter": "workspace:*",
    "@saxonberg/content-world-seed": "workspace:*"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint . --ext .ts,.tsx --cache",
    "lint:gates": "pnpm --filter @saxonberg/server run lint:gates",
    "lint:object-verbs": "pnpm --filter @saxonberg/server run lint:object-verbs",
    "lint:census": "pnpm --filter @saxonberg/server run lint:census",
    "lint:perishable": "pnpm --filter @saxonberg/server run lint:perishable",
    "lint:locations": "pnpm --filter @saxonberg/server run lint:locations",
    "lint:field-meta": "pnpm --filter @saxonberg/server run lint:field-meta",
    "lint:does-nothing": "pnpm --filter @saxonberg/server run lint:does-nothing",
    "lint:inert-weapon": "pnpm --filter @saxonberg/server run lint:inert-weapon",
    "test": "pnpm --filter='!@saxonberg/e2e' -r test",
    "test:gym": "pnpm --filter @saxonberg/server run test:gym",
    "test:near": "pnpm --filter @saxonberg/server run test:near",
    "test:watch": "pnpm --filter='!@saxonberg/e2e' -r test:watch",
    "e2e": "pnpm --filter @saxonberg/e2e test",
    "bench": "pnpm --filter @saxonberg/server run bench",
    "dev:server": "pnpm --filter @saxonberg/server dev",
    "dev:client": "pnpm --filter @saxonberg/client dev",
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:clean": "node packages/server/scripts/dev-preflight.mjs --all",
    "docs": "pnpm run docs:server && pnpm run docs:project",
    "docs:server": "pnpm --filter @saxonberg/server run docs",
    "docs:project": "pnpm --filter @saxonberg/server run docs:project",
    "docs:clean": "pnpm --filter @saxonberg/server run docs:clean",
    "test:e2e:platform": "pnpm --filter @saxonberg/e2e test:platform"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "typescript": "^5.4.0"
  }
}
