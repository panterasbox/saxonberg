PORT=3005
NODE_ENV=development

# Livestream broadcast feed (Phase 1). Both optional — unset = feed disabled.
# BROADCAST_TOKEN: secret for read-only overlay (OBS) connections via
#   wss://<host>/?broadcast=<token>. Must be >= 16 chars or the feed stays
#   disabled (fail-loud). Must match the overlay's VITE_BROADCAST_TOKEN.
# BROADCAST_TOKEN=change-me-to-a-long-random-secret
#
# STREAMER_PLAYER_IDS: comma-separated Avatar playerIds added to the
#   `streamers` group at boot (additive, idempotent) — these accounts can
#   run the `stream` verb. Find your playerId in the `users` collection
#   (playerIds array) or your avatar template path `/obj/Avatar/<playerId>`.
# STREAMER_PLAYER_IDS=your-player-id-here
#
# OVERLAY_TWITCH_LOGIN / OVERLAY_YOUTUBE_CHANNEL: the single overlay owner's
#   OWN external channels. While a broadcast overlay is connected, the relay
#   reads these channels' chat (presence-gated) and forwards it onto the
#   BroadcastFeed as `relay-chat` envelopes (the pbox-stream overlay renders
#   them). OVERLAY_TWITCH_LOGIN is a Twitch login; OVERLAY_YOUTUBE_CHANNEL is
#   a YouTube @handle / UC… channelId. Both optional.
#   OVERLAY_KICK_CHANNEL is a Kick channel slug.
# OVERLAY_TWITCH_LOGIN=your-twitch-login
# OVERLAY_YOUTUBE_CHANNEL=@yourhandle
# OVERLAY_KICK_CHANNEL=your-kick-slug

# YouTube read-only chat relay (single operator reader account). All three
#   required to enable YouTube `tune`/`watch @handle`; unset = YouTube relay
#   disabled (`tune … --youtube` reports "not configured"). The reader account
#   needs the `youtube.readonly` scope; no per-player Google tokens, no
#   GoogleProfile change (posting is deferred).
# YOUTUBE_READER_CLIENT_ID=your-oauth-client-id
# YOUTUBE_READER_CLIENT_SECRET=your-oauth-client-secret
# YOUTUBE_READER_REFRESH_TOKEN=your-reader-refresh-token
#
# WIZARD_PLAYER_IDS: comma-separated Avatar playerIds added to the
#   `wizards` group at boot (additive, idempotent) — the code-trust axis.
#   Wizards can `eval`, `reload`, write TypeScript source, and set the
#   executable code-naming fields (`class` / `hydratorClass` /
#   `behaviors[].brain`) on a content template. Everyone else who authors
#   is a protowizard (content, not code).
# WIZARD_PLAYER_IDS=your-player-id-here
#
# ARCHWIZARD_PLAYER_IDS: comma-separated Avatar playerIds added to the
#   `archwizards` group at boot (additive, idempotent). Archwizards confer
#   or revoke wizard status via `wizard grant/revoke <player>`. Operator/
#   root-managed for now (env seed + the `group` verb).
# ARCHWIZARD_PLAYER_IDS=your-player-id-here

# FOUNDER_GOOGLE_EMAIL / FOUNDER_TWITCH_HANDLE: the founding principal's
#   external credential — the founder is the default holder of every
#   government office (Art. XI pool-of-one) and the only appointer who can
#   hand a seat off (`office assign/vacate`). Set either or both; a logged-in
#   player whose linked Google email or Twitch handle matches is the founder.
#   Distinct from the wizard/archwizard code-trust axes and the streamers
#   axis — this is governance root-power. Twitch handle is matched
#   case-insensitively (stored lowercased as the Twitch `login`).
# FOUNDER_GOOGLE_EMAIL=bobalu@panterasbox.com
# FOUNDER_TWITCH_HANDLE=Bobalu_Smallberries

# Twitch auth (auth-providers Phase 1). All optional — unset = the Twitch
# login strategy is skipped and its start-screen button renders disabled.
# Register an app at https://dev.twitch.tv/console/apps as a Confidential
# client; register the redirect URLs
# http://localhost:2010/auth/twitch/callback and
# .../auth/twitch/link/callback (+ the https://<live-host>/... equivalents).
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_CALLBACK_URL=http://localhost:2010/auth/twitch/callback
#
# Kick auth + relay (feature/kick-relay). All optional — unset = the Kick
# login strategy is skipped (button disabled) and the chat relay is
# dormant. Create an app on kick.com (Settings -> Developer; 2FA
# required); enable scopes user:read + channel:read (+ events:subscribe
# for the relay; chat:write reserved for phase-2 posting); register the
# redirect URLs http://localhost:2010/auth/kick/callback and
# .../auth/kick/link/callback (+ the https://<live-host>/... equivalents).
# KICK_WEBHOOK_URL is only for the chat relay: the public HTTPS delivery
# URL registered in the dev app (<host>/webhooks/kick — a tunnel for
# local dev); leave unset to keep the relay dormant (login/link/watch
# all still work).
# KICK_CLIENT_ID=
# KICK_CLIENT_SECRET=
# KICK_CALLBACK_URL=http://localhost:2010/auth/kick/callback
# KICK_WEBHOOK_URL=
#
# TOKEN_ENC_KEY: AES-256 key encrypting Twitch/Kick OAuth tokens at rest.
#   Required only once a TwitchProfile/KickProfile is actually written
#   (validated lazily). Generate: openssl rand -base64 32
# TOKEN_ENC_KEY=
