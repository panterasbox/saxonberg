PORT=3005
NODE_ENV=development

# Livestream broadcast feed (Phase 1). Both optional — unset = feed disabled.
# BROADCAST_TOKEN: secret for read-only overlay (OBS) connections via
#   wss://<host>/?broadcast=<token>. Must be >= 16 chars or the feed stays
#   disabled (fail-loud). Must match the overlay's VITE_BROADCAST_TOKEN.
# BROADCAST_TOKEN=change-me-to-a-long-random-secret
#
# STREAMER_PLAYER_IDS: comma-separated Avatar playerIds added to the
#   `streamers` group at boot (additive, idempotent) — these accounts can
#   run the `stream` verb. Find your playerId in the `users` collection
#   (playerIds array) or your avatar template path `/obj/Avatar/<playerId>`.
# STREAMER_PLAYER_IDS=your-player-id-here
