PORT=3005
NODE_ENV=development

# Livestream broadcast feed (Phase 1). Both optional — unset = feed disabled.
# BROADCAST_TOKEN: secret for read-only overlay (OBS) connections via
#   wss://<host>/?broadcast=<token>. Must be >= 16 chars or the feed stays
#   disabled (fail-loud). Must match the overlay's VITE_BROADCAST_TOKEN.
# BROADCAST_TOKEN=change-me-to-a-long-random-secret
#
# STREAMER_PLAYER_IDS: comma-separated Avatar playerIds added to the
#   `streamers` group at boot (additive, idempotent) — these accounts can
#   run the `stream` verb. Find your playerId in the `users` collection
#   (playerIds array) or your avatar template path `/obj/Avatar/<playerId>`.
# STREAMER_PLAYER_IDS=your-player-id-here
#
# WIZARD_PLAYER_IDS: comma-separated Avatar playerIds added to the
#   `wizards` group at boot (additive, idempotent) — the code-trust axis.
#   Wizards can `eval`, `reload`, write TypeScript source, and set the
#   executable code-naming fields (`class` / `hydratorClass` /
#   `behaviors[].brain`) on a content template. Everyone else who authors
#   is a protowizard (content, not code).
# WIZARD_PLAYER_IDS=your-player-id-here
#
# ARCHWIZARD_PLAYER_IDS: comma-separated Avatar playerIds added to the
#   `archwizards` group at boot (additive, idempotent). Archwizards confer
#   or revoke wizard status via `wizard grant/revoke <player>`. Operator/
#   root-managed for now (env seed + the `group` verb).
# ARCHWIZARD_PLAYER_IDS=your-player-id-here

# Twitch auth (auth-providers Phase 1). All optional — unset = the Twitch
# login strategy is skipped (Google-only). Register an app at
# https://dev.twitch.tv/console/apps as a Confidential client; register the
# redirect URLs http://localhost:2010/auth/twitch/callback and
# .../auth/twitch/link/callback (+ the https://<live-host>/... equivalents).
pp#
# TOKEN_ENC_KEY: AES-256 key encrypting Twitch OAuth tokens at rest.
#   Required only once a TwitchProfile is actually written (validated lazily).
#   Generate: openssl rand -base64 32
# TOKEN_ENC_KEY=
