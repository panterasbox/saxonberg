{
  "name": "@saxonberg/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./mud/lib/*": "./src/mud/lib/*.ts",
    "./mud/api/*": "./src/mud/api/*.ts",
    "./mud/api/mql/*": null,
    "./mud/api/mml/*": null,
    "./mud/platform/thing/*": "./src/mud/platform/thing/*.ts",
    "./mud/platform/idea/*": "./src/mud/platform/idea/*.ts",
    "./mud/platform/idea/api/*": null,
    "./mud/platform/idea/hooks/*": null,
    "./mud/platform/agent/*": "./src/mud/platform/agent/*.ts",
    "./mud/platform/location/*": "./src/mud/platform/location/*.ts",
    "./test-bootstrap": "./src/test-bootstrap.ts",
    "./services/loader/vite-plugin": "./src/services/loader/vite-plugin.js"
  },
  "scripts": {
    "dev": "node scripts/dev-preflight.mjs 2010 server && AUTH_MODE=test tsx watch src/preload.js",
    "build": "tsc",
    "start": "tsx src/preload.js",
    "test": "vitest run",
    "test:gym": "vitest run --config vitest.gym.config.ts",
    "test:near": "tsx scripts/test-near.ts",
    "test:watch": "vitest",
    "test:escape": "vitest run src/mud/lib/sandbox/__tests__/escape",
    "bench": "tsx scripts/bench-suite.ts",
    "docs": "typedoc",
    "docs:project": "tsx scripts/project-author-surface.ts",
    "docs:clean": "rm -rf docs/api",
    "lint:gates": "tsx scripts/check-gate-strings.ts",
    "lint:blessed-bands": "tsx scripts/check-blessed-bands.ts",
    "lint:field-meta": "tsx scripts/check-field-meta.ts --lint",
    "lint:module-scope": "tsx scripts/check-module-scope.ts",
    "lint:boundary": "tsx scripts/check-boundary-exemptions.ts",
    "lint:world-scan": "tsx scripts/check-world-scan.ts",
    "lint:thin-forwarder": "tsx scripts/check-thin-forwarder.ts",
    "lint:pm": "tsx scripts/check-pm-access.ts",
    "lint:imports": "tsx scripts/check-mud-imports.ts",
    "lint:does-nothing": "tsx scripts/check-does-nothing.ts",
    "lint:inert-weapon": "tsx scripts/check-inert-weapon.ts",
    "lint:combat-dynamics": "tsx scripts/check-combat-dynamics.ts",
    "lint:instanceable": "tsx scripts/check-instanceable-placement.ts",
    "lint:census": "tsx scripts/check-template-census.ts",
    "lint:arg-kinds": "tsx scripts/check-arg-kinds.ts",
    "lint:descriptors": "tsx scripts/check-descriptor-banks.ts",
    "lint:topics": "tsx scripts/check-topic-keys.ts --lint",
    "lint:test-bootstrap": "tsx scripts/check-test-bootstrap.ts --lint",
    "lint:test-content": "tsx scripts/check-test-content.ts --lint",
    "lint:untitled": "tsx scripts/check-untitled-paths.ts --lint",
    "lint:test-bootstrap:verify": "tsx scripts/check-test-bootstrap.ts --verify"
  },
  "dependencies": {
    "@saxonberg/types": "workspace:*",
    "@twurple/auth": "^8.1.4",
    "ajv": "^8.20.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-session": "^1.18.0",
    "geoip-lite": "^2.0.3",
    "liquidjs": "^10.25.7",
    "mongodb": "^6.3.0",
    "nanoid": "^5.0.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-oauth2": "^1.8.0",
    "simple-git": "^3.27.0",
    "ws": "^8.16.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.0",
    "@types/express-session": "^1.18.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^20.0.0",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/passport-oauth2": "^1.8.0",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.5.10",
    "fast-check": "^4.7.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
