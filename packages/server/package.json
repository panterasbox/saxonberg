{
  "name": "@saxonberg/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./mud/lib/*": "./src/mud/lib/*.ts",
    "./mud/api/*": "./src/mud/api/*.ts",
    "./mud/api/mql/*": null,
    "./mud/api/mml/*": null,
    "./mud/platform/thing/*": "./src/mud/platform/thing/*.ts",
    "./mud/platform/idea/*": "./src/mud/platform/idea/*.ts",
    "./mud/platform/idea/api/*": null,
    "./mud/platform/idea/hooks/*": null,
    "./mud/platform/agent/*": "./src/mud/platform/agent/*.ts",
    "./mud/platform/location/*": "./src/mud/platform/location/*.ts",
    "./test-bootstrap": "./src/test-bootstrap.ts",
    "./services/loader/vite-plugin": "./src/services/loader/vite-plugin.js"
  },
  "scripts": {
    "bench": "tsx scripts/bench-suite.ts",
    "build": "tsc",
    "dev": "node scripts/dev-preflight.mjs 2010 server && AUTH_MODE=test tsx watch src/preload.js",
    "docs": "typedoc",
    "docs:clean": "rm -rf docs/api",
    "docs:project": "tsx scripts/project-author-surface.ts",
    "formulae": "tsx scripts/check-formulae.ts",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "lint:arg-kinds": "tsx scripts/check-arg-kinds.ts --lint",
    "lint:binder-models": "tsx scripts/check-binder-models.ts --lint",
    "lint:blessed-bands": "tsx scripts/check-blessed-bands.ts",
    "lint:boundary": "tsx scripts/check-boundary-exemptions.ts",
    "lint:capabilities": "tsx scripts/check-capabilities.ts",
    "lint:census": "tsx scripts/check-template-census.ts",
    "lint:combat-dynamics": "tsx scripts/check-combat-dynamics.ts",
    "lint:committees-are-players": "tsx scripts/check-committees-are-players.ts --lint",
    "lint:condition-arms": "tsx scripts/check-condition-arms.ts",
    "lint:conditions": "tsx scripts/check-conditions.ts",
    "lint:counters": "tsx scripts/check-counters.ts",
    "lint:descriptors": "tsx scripts/check-descriptor-banks.ts",
    "lint:dispositions": "tsx scripts/check-dispositions.ts",
    "lint:does-nothing": "tsx scripts/check-does-nothing.ts",
    "lint:doneness": "tsx scripts/check-doneness.ts",
    "lint:dossiers": "tsx scripts/check-dossiers.ts",
    "lint:drive-scripts": "tsx scripts/check-drive-scripts.ts",
    "lint:family": "tsx scripts/lint-family.ts",
    "lint:field-meta": "tsx scripts/check-field-meta.ts --lint",
    "lint:gates": "tsx scripts/check-gate-strings.ts",
    "lint:get-or-create": "tsx scripts/check-get-or-create.ts",
    "lint:identity": "tsx scripts/check-identity.ts",
    "lint:imports": "tsx scripts/check-mud-imports.ts",
    "lint:inert-weapon": "tsx scripts/check-inert-weapon.ts",
    "lint:instanceable": "tsx scripts/check-instanceable-placement.ts",
    "lint:instrument-args": "tsx scripts/check-instrument-args.ts",
    "lint:kept-animals": "tsx scripts/check-kept-animals.ts",
    "lint:lib-statics": "tsx scripts/check-lib-statics.ts --lint",
    "lint:locations": "tsx scripts/check-location-classes.ts",
    "lint:mixin-names": "tsx scripts/check-mixin-names.ts --lint",
    "lint:module-scope": "tsx scripts/check-module-scope.ts",
    "lint:no-authored-faucet": "tsx scripts/check-no-authored-faucet.ts --lint",
    "lint:object-verbs": "tsx scripts/check-object-verbs.ts",
    "lint:pathogens": "tsx scripts/check-pathogens.ts",
    "lint:perishable": "tsx scripts/check-perishable.ts",
    "lint:person-keys": "tsx scripts/check-person-keys.ts",
    "lint:pm": "tsx scripts/check-pm-access.ts",
    "lint:presentation": "tsx scripts/check-presentation.ts --lint",
    "lint:schema": "tsx scripts/check-schema-docs.ts --lint",
    "lint:spell-cost": "tsx scripts/check-spell-cost.ts",
    "lint:test-bootstrap": "tsx scripts/check-test-bootstrap.ts --lint",
    "lint:test-bootstrap:verify": "tsx scripts/check-test-bootstrap.ts --verify",
    "lint:test-content": "tsx scripts/check-test-content.ts --lint",
    "lint:thin-forwarder": "tsx scripts/check-thin-forwarder.ts",
    "lint:topics": "tsx scripts/check-topic-keys.ts --lint",
    "lint:unconsumed-seams": "tsx scripts/check-unconsumed-seams.ts",
    "lint:untitled": "tsx scripts/check-untitled-paths.ts --lint",
    "lint:verb-collisions": "tsx scripts/check-verb-collisions.ts",
    "lint:whole-table": "tsx scripts/check-whole-table.ts",
    "lint:world-scan": "tsx scripts/check-world-scan.ts",
    "reset:db": "tsx scripts/reset-db.ts",
    "start": "tsx src/preload.js",
    "test": "vitest run",
    "test:escape": "vitest run src/mud/lib/sandbox/__tests__/escape",
    "test:gym": "vitest run --config vitest.gym.config.ts",
    "test:near": "tsx scripts/test-near.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@saxonberg/types": "workspace:*",
    "@twurple/auth": "^8.1.4",
    "ajv": "^8.20.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-session": "^1.18.0",
    "geoip-lite": "^2.0.3",
    "liquidjs": "^10.25.7",
    "mongodb": "^6.3.0",
    "nanoid": "^5.0.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-oauth2": "^1.8.0",
    "simple-git": "^3.27.0",
    "ws": "^8.16.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.0",
    "@types/express-session": "^1.18.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^20.0.0",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/passport-oauth2": "^1.8.0",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.5.10",
    "fast-check": "^4.7.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
