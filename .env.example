# pbox-stream overlay configuration. Copy to `.env` (gitignored) and fill in.
#
# Broadcast feed (Phase 1): point the overlays at a running saxonberg
# server and authenticate with its BROADCAST_TOKEN. When unset, overlays
# run in offline/demo mode (the standby countdown falls back to the
# `?until=<epoch_ms>` URL param, then a 15-minute demo).

# Saxonberg WebSocket origin (no path). Dev default shown.
VITE_SAXONBERG_WS=ws://localhost:2010

# Must match the server's BROADCAST_TOKEN (>= 16 chars). Rides in the WS
# query param; keep the OBS browser-source URL private.
VITE_BROADCAST_TOKEN=
