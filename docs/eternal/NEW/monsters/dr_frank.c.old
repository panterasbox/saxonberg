/*
**  Monster : Dr. Frankenstein
*/

inherit MonsterCode;
inherit MonsterTalk;

void extra_create()
{
    object tmp;

    set_name("Dr. Frankenstein");
    add_alias("frankenstein");
    add_alias("doctor");
    set_short("Dr. Frankenstein sits behind a table here");
    set_long("Sitting behind one of the steel tables here is an odd looking man.\n" +
        "He stares blankly at you through glossy eyes and with a crooked\n" +
        "looking smile on his lips.  He finally appears to notice your stare\n" +
        "and says 'Good evening!  How may I help you?  Should you be dead,\n" +
        "I can <regenerate> you if needed!\n");
    set_race("human");
    set_max_hp(10000);
    set_max_fatigue(10000);
    set_max_damage(25);
    set_hit_bonus(3);
    set_damage_bonus(3);
    set_type("blunt");
    set_natural_ac(15);
    set_offensive_level(500);
    set_defensive_level(500);
    set_chat_chance(100);
    set_chat_rate(50);  /* Nightswimmer 2/16/93 */
    add_combat_phrase("Dr. Frankenstein says: At last!  New body parts!\n");
    set_alignment(1000);
    set_aggressive(0);
    set_heal_rate(20);
    set_heal_amount(50);
    set_stat("str", 100);
    set_stat("dex", 100);
    set_stat("con", 100);
    set_stat("wil", 100);
    set_stat("int", 100);
    set_stat("chr", 100);
    set_skill("dodge", 50);
}

