//	Inside the Towncar by Anthrax
//	(some parts hacked from /secure/player/commands/look.c)

#include "/zone/null/eternal/eternal.h"
#define HEART "/zone/null/eternal/common"
#define GARAGE "/zone/null/eternal/garage"
#define CAR "/zone/null/eternal/objects/sedan"
#define AMT 3
#define MAXEVAL 5
inherit RoomPlusCode;

object car;
closure exit_sort, exit_map;
status homing, deposit;

extra_create()
{
    set("short","Inside a Towncar");
    set("day_long", "The interior of the sedan is plush and "+
      "roomy, with plenty of space for the whole family.  "+
      "The steering wheel is comfortable, and it drives "+
      "well on standard streets.  You can <look out> of "+
      "the tinted windows, and enjoy your privacy. "+
      "A small note on the dash, above a button, catches "+
     "your eye as well." );
    set("descs", ([
	 ({"note","instructions"}):
	     "Players over eval "+to_string(MAXEVAL)+" must pay a "+
	     "deposit of "+to_string(AMT)+" coins to take the car "
	     "from the Garage.  To return the car and reclaim the "
	     "deposit, type 'return car' before you leave.\n",
      ]) );
    set("exits", ([ "out": "@go_out" ]) );
    set("day_light",80);
    set(NoCombatP,1);
    set(InsideP,1);
    exit_sort  = lambda( ({ 'one, 'two }),
      ({ #',,
        ({ #'=,
          'eo,
          '({ "down", "up", "southwest", "southeast", "northwest",
            "northeast", "west", "east", "south", "north", })
        }),
        ({ #'<,
          ({ #'searcha, 'eo, 'one }),
          ({ #'searcha, 'eo, 'two })
        })
      }) );
    exit_map   = lambda( ({ 'dir }),
      ({ #'?,
        ({ #'=,
          't,
          ({ #'[,
            ([
              "north": "n", "south": "s", "east": "e", "west": "w",
              "northeast": "ne", "northwest": "nw", "southeast": "se",
              "southwest": "sw", "up": "u", "down": "d",
            ]),
            'dir
          })
        }),
        't,
        'dir
      }) );

    seteuid(getuid());
}

extra_init()
{
    add_action("do_drive","drive");
    add_action("do_look","look");
    add_action("set_homing","return");
    add_action("deposit_money","deposit");
}

void set_car(object ob)
{
    if(program_name(previous_object()) != CAR) return;
    car = ob;
    return;
}

//  Hacked some of this out of /secure/player/commands/look.c
#define MAX_LIST 20
do_look(string str)
{
    string s, *dirs, out;
    int     i, size, wiz;
    object  me, *ob, env;
    mapping tmp; 

    if(!str || str != "out") return 0;

    env = ENV(car);
    me = THISP;
    wiz = IsWizard(me);

    if( me->query_brief() )
    {
        out  = env->short();
        dirs = m_indices( ( tmp = env->query( "exits" ) ) ? tmp : ([ ]) );
        if( !sizeof( dirs ) )
            out += "\n";
        else
            out += " <" + implode( map_array( sort_array( dirs,
                  exit_sort ), exit_map ), "," ) + ">\n";
    }
    else
    {
        out = env->long();
        if( !out )
            out = "";
        size = sizeof( ob = ( all_inventory( env ) - ({ car }) ) );
        for( i=MIN(size,MAX_LIST); i--; )
        {
            if( ob[ i ] )
                if( stringp( s = (string )ob[ i ]->short() ) )
                    out += strformat( capitalize( s ) + "." );
                else if( wiz )
                    out += strformat( file_name( ob[ i ] ) + " [invisible]" );
        }
    }
    write("Outside of the car, you see:\n");
    write( out );
    return 1;
}

do_drive(str)
{
    string dest;
    object room;
    int pass;

    if(!str) {
        write("Drive in which direction?\n");
        return 1; }

    room = ENV(car);
    switch(str) {
    case "u": str = "up"; break;
    case "d": str = "down"; break;
    case "n": str = "north"; break;
    case "s": str = "south"; break;
    case "e": str = "east"; break;
    case "w": str = "west"; break;
    case "nw": str = "northwest"; break;
    case "sw": str = "southwest"; break;
    case "ne": str = "northeast"; break;
    case "se": str = "southeast"; break;
    default: break; }

    dest = (room->query("exits") + room->query("invis_exits"))[str];

    if(!stringp(dest) || dest[0]=="@") {
        write("You cannot drive in that direction.\n");
        return 1; }

    if(!catch( pass = move_object(car,dest) ) && pass) {
	    write("You drive the car ");
	    write(PNAME+" drives the car ");
	    tell_room(THISO, str+".\n");
        tell_room(room,"The sedan zooms off "+str+".\n");
        tell_room(ENV(car),"A grey sedan pulls into the room.\n");
        do_look("out");
    } else
        write("That direction seems blocked.\n");

    return 1;
}

return_home(object who) {
	if(homing) {
	if(sizeof(filter_array(inventorya(THISO),#'living)))
	    tell_room(THISO, "Homing System Deactivated.\n");
	else {
	  tell_room(ENV(car),"The car zooms off to the Garage.\n");
	  move_object(car, GARAGE);
	  tell_room(ENV(car),"A grey sedan pulls in, and parks.\n");
          if(objectp(who)) {
            who->add_money(AMT);
            tell_object(who,"You are reimbursed the deposit for the car.\n");
	    }
	}
	}
	homing = 0;
	who = 0;
	deposit = 0;
	return 1;
}

go_out()
{
    if(!objectp(car)) {
        write("This isn't really in a car!\n");
        THISP->move_player("",HEART,1);
        return 1; }

    tell_room(ENV(car), "The door of the sedan opens, and ");
    THISP->move_player("out of the car",file_name(ENV(car)),1);

	if(homing)
	  return_home(deposit? THISP: 0);

    return 1;
}

set_homing(str) {
    if(!str || (str != "car" && str != "sedan") ) return 0;

    if(file_name(ENV(car))==GARAGE) {
        write("The car is already in the Garage.\n");
        return 1;}

    write("You press the car return button."+
      "\n");
    say(PNAME+" pushes the homing button on the dash.\n");
    tell_room(THISO,"A light on the dash comes on.  It reads: \n"
      "Homing System Activated -- Please Exit.\n");
    homing = 1;
    return 1;
}


extra_reset() {
	return_home(0);
}

deposit_money(string str) {
    if(!str || str != (to_string(AMT)+" coins")) return 0;
        if(!THISP->query_money(AMT))
            write("You don't have the necessary "+to_string(AMT)+
                  " coins.\n");
        else {
            THISP->add_money(-(AMT));
	    write("You may now drive the car out of the garage.\n");
	    deposit++;
        }
    return 1;
}

query_drive_ok(object who) {
	if(!objectp(who)) return 0;
	if(MISCFUN->evaluation(who)<=MAXEVAL) return 0;
	if(deposit) return 0;
	return 1;
}
