race_thingy()
  { 
  command( "say I've worked too hard to have some two-bit "
    + lower_case( query("customer")->query_race() ) + 
    " fucking things up!", THISO );
  return 0;
  }  
 
finish_sternness()
  {
  query("stopper")->unleash();
  command( "say Ok now scat!  Type either \"quit\" or \"east\".",
    THISO );
  return 0;
  }
