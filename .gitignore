node_modules/
dist/
build/
.vite/

# Generated API documentation (TypeDoc HTML + JSON model). Regenerated
# via `pnpm docs`. The JSON model may later be promoted to a committed
# build input for the in-game help system (see docs phase 3).
packages/server/docs/api/
.env
.env.local
*.log
.DS_Store
coverage/
.turbo/
.next/
out/
*.tsbuildinfo
# .claude/ — the process skills and agents are TRACKED (they are load-bearing
# workflow docs); everything else under it stays local.
.claude/*
!.claude/skills/
!.claude/agents/
# ...and the /build skill's directory, which the generic `build/` rule
# above would otherwise swallow.
!.claude/skills/build/
.mcp.json
.eslintcache

# Vitest writes ephemeral compiled-config copies next to vitest.config.ts
# during runs. Don't track them.
*.timestamp-*.mjs

# Windows/WSL mark-of-the-web cruft
*:Zone.Identifier

# Manifesto diagram exports (regenerable from .excalidraw sources)
docs/manifesto/*.png

# generated slide PNG exports (Descript inputs; regenerate via slide-generator.py)
docs/manifesto/exports/

# tools/docs-mirror build output (published by CI, never committed)
.docs-mirror/
