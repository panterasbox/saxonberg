{
  "name": "@saxonberg/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "End-to-end browser tests (Playwright) for the Saxonberg client.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium",
    "test:platform": "playwright test -c playwright.platform.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.0.0"
  }
}
