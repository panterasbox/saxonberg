#!/usr/bin/env python3
"""Regenerate docs/slates/README.md from the slates' own status blocks.

The index is DERIVED. Every slate carries, under its H1:

    > **Status: PARTIAL** — what shipped → [subsystem.md](…)
    > **Left:** the named things that remain
    > **Size:** a build · a wave · a tail

This reads those three keys and emits the four tables. Nothing here
decides anything: if a row looks wrong, the slate's block is wrong, and
that is where it gets fixed.

    ./tools/slate-index          # rewrite README.md between the markers
    ./tools/slate-index --check  # non-zero if the file is stale (CI-able)
    ./tools/slate-index --audit  # report unparsable blocks and stop

⚠ The README is a SWEPT file (CLAUDE.md § Worktrees rule 5) — run this at
a sweep, not from four sessions at once.

⚠⚠ TWO AUTHORING CONSTRAINTS this parser imposes on a status block, both
found the hard way (2026-09-23) and neither obvious from the output:

  1. NO CONTINUATION LINE OF `Left:` MAY BEGIN WITH `> **`. The Left
     capture stops at the next line starting `> **` (it is how `Size:`
     is found), so a bolded item at the start of a wrapped line
     SILENTLY TRUNCATES the summary — the row still renders, just
     short, and nothing reports it. Keep bold mid-line.
  2. `Size:` TAKES A SINGULAR WORD — `a build`, `a wave`, `a tail`.
     `two builds` parses as NO SIZE (`\bbuild\b` does not match
     `builds`) and the slate is dropped from the index entirely.
     `--audit` does catch this one.
"""

import re
import sys
import pathlib

ROOT = pathlib.Path(__file__).resolve().parent.parent
SLATES = ROOT / "docs" / "slates"
README = SLATES / "README.md"

BEGIN = "<!-- BEGIN GENERATED — ./tools/slate-index -->"
END = "<!-- END GENERATED -->"

# Both spellings are in the tree and both are fine:
#   > **Status: PARTIAL** — …        (value inside the bold)
#   > **Status:** PARTIAL — …        (value after it)
STATUS = re.compile(r"^> \*\*Status:?\*?\*?\s*([A-Za-z]+)", re.M)
LEFT = re.compile(r"^> \*\*Left[^*]*:?\*\*[ \t]*(.*?)(?=^> \*\*|\Z)", re.M | re.S)
SIZE = re.compile(r"^> \*\*Size:?\*\*[ \t]*(.+)$", re.M)

# Which bucket a slate lands in. `Size` decides the folder; `Status`
# decides greenfield vs continuation. ⚠ The possessive is not a size:
# "a build's tail" is a TAIL, and reading the first word makes it a
# build — which is how `fishing` landed in the wrong column once.
SIZE_WORD = re.compile(r"\b(build|wave|tail)\b(?!'s)")


def size_of(raw: str) -> str | None:
    """First size word in the Size line — the rest is the slate's reasoning."""
    hit = SIZE_WORD.search(raw.lower())
    return hit.group(1) if hit else None


def clean(text: str, limit: int = 4) -> str:
    """The Left list as one line: unwrap, strip the blockquote, cap items.

    ⚠ Links inside a `Left` list are written relative to the SLATE; pasted
    into the README one directory up they all break. The link text is what
    carries meaning in a one-line summary, so the target is dropped — the
    slate itself is already linked in the first column.
    """
    text = re.sub(r"^> ?", "", text, flags=re.M)
    text = " ".join(text.split())
    text = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", text)
    text = text.replace("|", "\\|")
    if not text:
        return "—"
    parts = [p.strip() for p in text.split("·") if p.strip()]
    out = " · ".join(parts[:limit])
    return out + (" …" if len(parts) > limit else "")


FOLDERS = {
    "tech-debt": "Tech debt — refactors, sweeps, census-and-ratchet gates, performance, test tooling. Nothing a player would notice; everything the next build stands on.",
    "engine": "Engine — the world's systems: bodies, senses, combat, movement, physics, NPCs, the command language.",
    "trades": "Trades — industries and their supply chains: what is made, from what, by whom.",
    "society": "Society — governance, law, money, institutions, education, faith, standing.",
    "world": "World — places, peoples, creatures, lore and story content.",
    "client": "Client — the UI: cards, the shell, the map, rendering.",
    "platform": "Platform — authoring tools, packs, hosting, integrations, the show and the business.",
}

# The order a reader picks work in: nothing shipped, then remainders, then
# anything whose block says it is done (a retirement candidate), then the
# slates the generator cannot read.
STATUS_ORDER = [
    ("UNBUILT", "Unbuilt — nothing shipped yet"),
    ("PARTIAL", "Partial — substrate shipped, the remainder below"),
    ("DONE", "⚠ Says it is done — retire it, or fix the block"),
    ("?", "⚠ No readable status block — fix the block"),
]
DONE = {"BUILT", "SHIPPED", "ABSORBED"}


def bucket(status: str) -> str:
    if status == "UNBUILT":
        return "UNBUILT"
    if status in DONE:
        return "DONE"
    if status == "?":
        return "?"
    return "PARTIAL"  # PARTIAL, PARTLY, TAIL, SUBSTRATE, MEASURED, PARKED …


def read_slates():
    rows, broken = [], []
    for path in sorted(SLATES.glob("*/*.md")):
        if path.name == "README.md":
            continue
        body = path.read_text()
        status = STATUS.search(body)
        left = LEFT.search(body)
        size = SIZE.search(body)
        key = size_of(size.group(1)) if size else None
        if not (status and left and key):
            broken.append((path, bool(status), bool(left), bool(key)))
        rows.append(
            {
                "name": path.stem.removesuffix("-slate"),
                "file": path.name,
                "status": status.group(1).upper() if status and left else "?",
                "left": clean(left.group(1)) if left else "—",
                "size": key or "?",
                "folder": path.parent.name,
            }
        )
    return rows, broken


def folder_readme(folder: str, rows) -> str:
    title, _, blurb = FOLDERS.get(folder, folder + " — ").partition(" — ")
    out = [
        f"# {title}",
        "",
        blurb,
        "",
        "⚠ **Generated by `./tools/slate-index`** — edit a slate's status",
        "block, never this file. Back to [all slates](../README.md).",
        "",
    ]
    for key, heading in STATUS_ORDER:
        group = sorted(
            (r for r in rows if bucket(r["status"]) == key), key=lambda r: r["name"]
        )
        if not group:
            continue
        out += [
            f"## {heading} ({len(group)})",
            "",
            "| slate | size | status | left |",
            "|---|---|---|---|",
        ]
        out += [
            f"| [{r['name']}](./{r['file']}) | {r['size']} | {r['status']} | {r['left']} |"
            for r in group
        ]
        out.append("")
    return "\n".join(out)


def sections(rows) -> str:
    out = [
        BEGIN,
        "",
        f"**{len(rows)} slates in {len(FOLDERS)} folders.** Open a folder: its",
        "README lists every slate in it by status, with size and what is left.",
        "",
        "| folder | what is in it | unbuilt | partial | done? | no block |",
        "|---|---|---|---|---|---|",
    ]
    for folder, desc in FOLDERS.items():
        mine = [r for r in rows if r["folder"] == folder]
        n = {k: sum(1 for r in mine if bucket(r["status"]) == k) for k, _ in STATUS_ORDER}
        title, _, blurb = desc.partition(" — ")
        out.append(
            f"| [{folder}/](./{folder}/README.md) | {blurb.split('.')[0]} | "
            f"{n['UNBUILT']} | {n['PARTIAL']} | {n['DONE']} | {n['?']} |"
        )
    stray = sorted({r["folder"] for r in rows} - set(FOLDERS))
    if stray:
        out += ["", "⚠ Folders the generator does not know: " + ", ".join(stray)]
    out += ["", END]
    return "\n".join(out)


def main() -> int:
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    rows, broken = read_slates()

    if broken:
        print(f"⚠ {len(broken)} slate(s) with an unreadable status block:")
        for path, st, left, size in broken:
            missing = [
                k
                for k, ok in (("Status", st), ("Left", left), ("Size", size))
                if not ok
            ]
            print(f"  {path.relative_to(ROOT)} — no {', '.join(missing)}")
        if mode == "--audit":
            return 1
        print('  (listed under "no readable status block"; fix the block in the slate)')
    elif mode == "--audit":
        print(f"✓ all {len(rows)} status blocks parse")
        return 0

    generated = sections(rows)
    current = README.read_text()
    if BEGIN not in current or END not in current:
        print(f"✗ {README.relative_to(ROOT)} has no generated block markers")
        return 2
    head, rest = current.split(BEGIN, 1)
    _, tail = rest.split(END, 1)
    updated = head + generated + tail
    outputs = {README: updated}
    for folder in sorted({r["folder"] for r in rows}):
        mine = [r for r in rows if r["folder"] == folder]
        outputs[SLATES / folder / "README.md"] = folder_readme(folder, mine)

    if mode == "--check":
        stale = [p for p, text in outputs.items() if not p.exists() or p.read_text() != text]
        for p in stale:
            print(f"✗ {p.relative_to(ROOT)} is stale — run ./tools/slate-index")
        if not stale:
            print("✓ slate indexes are current")
        return 1 if stale else 0

    for p, text in outputs.items():
        p.write_text(text)
    print(f"✓ wrote {README.relative_to(ROOT)} — {len(rows)} slates")
    return 0


if __name__ == "__main__":
    sys.exit(main())
